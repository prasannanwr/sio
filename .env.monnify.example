# --- Monnify Credentials ---
# Get these from https://app.monnify.com -> Settings -> API Keys & Webhooks

MONNIFY_API_KEY=MK_TEST_XXXXXXXXXX
MONNIFY_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXX
MONNIFY_CONTRACT_CODE=1234567890

# Sandbox: https://sandbox.monnify.com
# Live:    https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com

MONNIFY_CURRENCY=NGN
MONNIFY_WEBHOOK_SECRET=your-webhook-secret-or-client-secret
MONNIFY_REDIRECT_URL=yourapp://payment/callback
MONNIFY_DISBURSEMENT_SOURCE_ACCOUNT_NUMBER=your-monnify-wallet-account-number
MONNIFY_DISBURSEMENT_ASYNC=true
MONNIFY_VERIFY_ACCOUNT_BEFORE_TRANSFER=true

# VTU payments should be completed through Monnify before fulfillment.
VTU_REQUIRE_SUCCESSFUL_PAYMENT=true

# Delivery man payouts are sent from the Monnify wallet to Nigerian bank accounts.
DELIVERY_PAYOUT_CURRENCY=NGN
DELIVERY_PAYOUT_PAYMENT_PROVIDER=monnify
